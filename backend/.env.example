NODE_ENV=development
PORT=3001
DATABASE_URL=file:./dev.db
POSTGRES_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/escola?schema=public
JWT_SECRET=
DATA_ENCRYPTION_KEY=
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
BACKEND_PUBLIC_URL=http://localhost:3001/api/v1
TELEGRAM_POLLING_ENABLED=false
TELEGRAM_DEBUG_LOG_ENABLED=false
FINANCEIRO_API_URL=http://localhost:3002/api/v1
FINANCEIRO_HMAC_ESCOLA_SECRET=
SOURCE_SYSTEM_ESCOLA_HMAC_SECRET=
FINANCEIRO_CALLBACK_TIMESTAMP_WINDOW_MS=60000
FINANCEIRO_CALLBACK_REPLAY_CACHE_MAX_ENTRIES=50000
MSINFOR_SERVICE_SUPERVISOR_URL=http://127.0.0.1:3199
MSINFOR_SERVICE_SUPERVISOR_SECRET_FILE=../../MSINFOR_INFRA/.secrets/service_supervisor_secret.txt
MSINFOR_CENTRAL_API_URL=http://localhost:3201/api/v1
MSINFOR_CENTRAL_SYSTEM_ID=ESCOLA
MSINFOR_CENTRAL_SYSTEM_KEY=
MSINFOR_CENTRAL_IDENTITY_ENABLED=false
MSINFOR_DATABASE_ALIAS=ESCOLA_LOCAL
AUTH_SESSION_MAX_PER_ACCOUNT=10
TRUST_PROXY_HOPS=0
ESCOLA_DATABASE_RUNTIME_ROLE=escola_app
SECRET_MIGRATION_BACKUP_DIR=.local-backups

# Gere DATA_ENCRYPTION_KEY com: openssl rand -base64 32
# Em Docker de producao, use os arquivos *_FILE definidos no compose; nao
# injete JWT, chave AES, DATABASE_URL ou chaves técnicas diretamente no ambiente.
# Em producao, FRONTEND_URL, CORS_ALLOWED_ORIGINS, BACKEND_PUBLIC_URL,
# FINANCEIRO_API_URL e MSINFOR_CENTRAL_API_URL devem usar HTTPS. Polling e
# debug do Telegram devem permanecer false; o token global e proibido.

# Desabilitado por padrão em produção.
ENABLE_API_DOCS=false
